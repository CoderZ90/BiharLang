bol "Patterns:"
bol ""

rakha rows = 5
rakha i = 1

jabtak (i <= rows) {
    rakha spaces = ""
    rakha s = 1
    jabtak (s <= rows - i) {
        rakha spaces = spaces + " "
        rakha s = s + 1
    }

    rakha stars = ""
    rakha j = 1
    jabtak (j <= i * 2 - 1) {
        rakha stars = stars + "*"
        rakha j = j + 1
    }

    bol spaces + stars
    rakha i = i + 1
}